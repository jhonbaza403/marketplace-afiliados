// Array de productos (o cargado mediante fetch('products.json'))
const products = [ /* ...aquí tu JSON... */ ];

const container = document.getElementById('products-grid');

function renderProducts(items) {
  if (!container) return;
  
  if (items.length === 0) {
    container.innerHTML = `<p class="error">No se encontraron productos disponibles.</p>`;
    return;
  }

  container.innerHTML = items.map(product => {
    // Determinar la clase de insignia de la tienda para los estilos CSS
    const storeClass = product.store.toLowerCase().replace(/\s+/g, '');
    
    // Determinar el plan si aplica (o por defecto según la tienda)
    const isGlobal = ['amazon', 'shein', 'aliexpress', 'alibaba'].includes(storeClass);
    const planType = isGlobal ? 'global' : 'nacional';

    return `
      <article class="product-card">
        <div class="card-image">
          <span class="discount-badge">${product.discount}</span>
          <span class="store-badge ${storeClass}">${product.store}</span>
          <img src="${product.image}" alt="${product.title}" loading="lazy" />
        </div>
        
        <div class="card-content">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span class="category">${product.category}</span>
            <span class="plan-badge ${planType}">${planType}</span>
          </div>
          
          <h3 class="title">${product.title}</h3>
          
          <div class="price-rating">
            <span class="price">$${product.price.toFixed(2)} ${product.currency}</span>
            <span class="rating">★ ${product.rating}</span>
          </div>
          
          <div class="card-actions">
            <a href="${product.affiliateUrl}" target="_blank" rel="noopener noreferrer" class="buy-btn" style="flex: 1;">
              ${product.store === 'Mayor' || product.store === 'Servicios' || product.store === 'Detal' ? 'Contactar' : 'Ver Oferta'}
            </a>
            <button class="share-btn" onclick="shareProduct('${product.title}', '${product.affiliateUrl}')" style="background:#f1f5f9; border:1px solid #cbd5e1; padding: 0 12px; border-radius: 10px; cursor: pointer;">
              🔗
            </button>
          </div>
        </div>
      </article>
    `;
  }).join('');
}

// Función para compartir enlace
function shareProduct(title, url) {
  if (navigator.share) {
    navigator.share({ title: title, url: url }).catch(() => {});
  } else {
    navigator.clipboard.writeText(url);
    alert('¡Enlace copiado al portapapeles!');
  }
}

// Inicializar la vista
document.addEventListener('DOMContentLoaded', () => {
  renderProducts(products);
});
